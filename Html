function renderManageGrid(){
  const grid=document.getElementById('manage-grid');
  const photos=getCustomPhotos();
  if(!photos.length){
    grid.innerHTML='<div class="manage-empty">No custom photos yet.<br>Use the 📷 button in any symbol bank to add one.</div>';
    return;
  }
  grid.innerHTML='';
  photos.forEach(p=>{
    const card=document.createElement('div');
    card.className='manage-card';
    card.innerHTML=`
      <img src="${p.data}" alt="${p.label}">
      <span class="mc-name">${p.label}</span>
      <button class="mc-del" aria-label="Delete ${p.label}"
              onclick="deleteCustomPhoto('${p.id}')">✕</button>`;
    grid.appendChild(card);
  });
}

function deleteCustomPhoto(id){
  const photos=getCustomPhotos();
  const photo=photos.find(p=>p.id===id);
  if(!photo) return;
  if(!confirm(`Delete "${photo.label}"?\n\nAny student who had this photo placed will show a placeholder instead.`)) return;
  saveCustomPhotos(photos.filter(p=>p.id!==id));
  // Remove from all open banks
  document.querySelectorAll(`[data-id="${id}"]`).forEach(e=>e.remove());
  renderManageGrid();
  announce(photo.label+' deleted.');
}

