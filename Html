let dragSym=null;
document.addEventListener('dragstart',e=>{
  const s=e.target.closest('.sym'); if(!s) return;
  dragSym=s; s.classList.add('dragging'); e.dataTransfer.effectAllowed='copy';
  if(_isCustomSym(s)) _showTrash();
});
document.addEventListener('dragend',e=>{
  const s=e.target.closest('.sym'); if(s) s.classList.remove('dragging');
  dragSym=null; _hideTrash();
});

// Wire trash can for desktop drag
(function(){
  const trash=document.getElementById('drag-trash');
  trash.addEventListener('dragover', e=>{ e.preventDefault(); e.dataTransfer.dropEffect='move'; _trashOver(); });
  trash.addEventListener('dragleave', _trashOut);
  trash.addEventListener('drop', e=>{
    e.preventDefault(); _hideTrash();
    if(dragSym && _isCustomSym(dragSym)) _deleteCustomSym(dragSym);
  });
})();

function dzOver(e){ e.preventDefault(); e.currentTarget.classList.add('drag-over'); }
function dzLeave(e){ e.currentTarget.classList.remove('drag-over'); }
function dzDrop(e,pageKey){ e.preventDefault(); e.currentTarget.classList.remove('drag-over'); if(dragSym) placeCard(e.currentTarget,dragSym,pageKey); }

/* ═══════════════════════════════════════════
   TOUCH DRAG (mobile pointer events)
═══════════════════════════════════════════ */
(function initTouch(){
  let ghost=null,tSym=null,tPage=null,ox=0,oy=0;
  document.addEventListener('pointerdown',e=>{
    const sym=e.target.closest('.sym');
    if(!sym||sym.classList.contains('used')||e.pointerType==='mouse') return;
    e.preventDefault(); sym.setPointerCapture(e.pointerId);
    tSym=sym; tPage=sym.dataset.page;
    ghost=document.createElement('div');
    ghost.style.cssText='position:fixed;z-index:9999;pointer-events:none;background:#fff;border:3px solid #555;border-radius:12px;padding:6px 8px;display:flex;flex-direction:column;align-items:center;gap:3px;opacity:.9;box-shadow:0 8px 24px rgba(0,0,0,.28);';
    const img=sym.querySelector('img'), ph=sym.querySelector('.img-ph');
    if(img&&img.style.display!=='none') ghost.innerHTML=`<img src="${img.src}" style="width:50px;height:50px;object-fit:contain"><span style="font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:.72rem">${sym.dataset.label}</span>`;
    else ghost.innerHTML=`<div style="font-size:2rem">${ph?ph.textContent:'🖼️'}</div><span style="font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:.72rem">${sym.dataset.label}</span>`;
    const r=sym.getBoundingClientRect(); ox=e.clientX-r.left; oy=e.clientY-r.top;
    ghost.style.left=(e.clientX-ox)+'px'; ghost.style.top=(e.clientY-oy)+'px';
    document.body.appendChild(ghost); sym.classList.add('dragging');
    if(_isCustomSym(sym)) _showTrash();
  },{passive:false});

  document.addEventListener('pointermove',e=>{
    if(!ghost) return; e.preventDefault();
    ghost.style.left=(e.clientX-ox)+'px'; ghost.style.top=(e.clientY-oy)+'px';
    // Highlight trash when hovering over it
    if(_isCustomSym(tSym)){
      const trash=document.getElementById('drag-trash');
      const tr=trash.getBoundingClientRect();
      const over=e.clientX>=tr.left&&e.clientX<=tr.right&&e.clientY>=tr.top&&e.clientY<=tr.bottom;
      over ? _trashOver() : _trashOut();
    }
  },{passive:false});

  document.addEventListener('pointerup',e=>{
    if(!ghost||!tSym) return;
    ghost.remove(); ghost=null; tSym.classList.remove('dragging');

    // Check if released over trash
    const trash=document.getElementById('drag-trash');
    const tr=trash.getBoundingClientRect();
    const overTrash=e.clientX>=tr.left&&e.clientX<=tr.right&&e.clientY>=tr.top&&e.clientY<=tr.bottom;

    if(overTrash && _isCustomSym(tSym)){
      _hideTrash();
      _deleteCustomSym(tSym);
    } else {
      _hideTrash();
      const el=document.elementFromPoint(e.clientX,e.clientY);
      const zone=el?el.closest('.drop-zone'):null;
      if(zone) placeCard(zone,tSym,tPage);
    }
    tSym=null; tPage=null;
  });
})();

