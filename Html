═══════════════════════════════════════════ */
function placeCard(zone,symEl,pageKey){
  const id=symEl.dataset.id, label=symEl.dataset.label;
  _renderCard(zone,id,label,pageKey);
  symEl.classList.add('used');
  const ps=getPageState(pageKey);
  const cards=ps[zone.id]||[];
  if(!cards.find(c=>c.id===id)) cards.push({id,label});
  setZoneState(pageKey,zone.id,cards);
}

function _renderCard(zone,id,label,pageKey){
  const ph=zone.querySelector('.dz-ph'); if(ph) ph.style.display='none';
  const isCustom=String(id).startsWith('custom:');
  const fb=isCustom ? '📷' : (EMOJI_FB[parseInt(id)]||'⭐');
  const src=isCustom ? imgUrl(id) : imgUrl(id);
  const card=document.createElement('div');
  card.className='dropped'; card.dataset.cardId=id;
  card.setAttribute('role','img'); card.setAttribute('aria-label',`${label}, tap × to remove`);
  card.innerHTML=`
    <img src="${src}" alt="${label}"
         onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
    <div class="d-em" style="display:none">${fb}</div>
    <span class="d-word">${label}</span>
    <button class="d-remove" aria-label="Remove ${label}"
            onclick="removeCard(this,'${id}','${pageKey}')">✕</button>`;
  zone.querySelector('.dz-cards').appendChild(card);
}

function removeCard(btn,id,pageKey){
  const card=btn.closest('.dropped'), zone=card.closest('.drop-zone');
  card.remove();
  if(!zone.querySelectorAll('.dropped').length){
    const ph=zone.querySelector('.dz-ph'); if(ph) ph.style.display='';
  }
  document.querySelectorAll(`#aac-sec-${pageKey} [data-id="${id}"]`).forEach(e=>e.classList.remove('used'));
  const ps=getPageState(pageKey);
  if(ps[zone.id]) ps[zone.id]=ps[zone.id].filter(c=>c.id!==id);
  setZoneState(pageKey,zone.id,ps[zone.id]||[]);
}

