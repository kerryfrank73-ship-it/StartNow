/* resize + convert to base64 */
function processImageFile(file){
  if(!file||!file.type.startsWith('image/')){ alert('Please choose an image file (JPG, PNG, GIF, or WebP).'); return; }
  const MAX=120; // px — keeps each stored photo ~10–20 KB
  const reader=new FileReader();
  reader.onload=e=>{
    const img=new Image();
    img.onload=()=>{
      const canvas=document.createElement('canvas');
      const scale=Math.min(1, MAX/Math.max(img.width,img.height));
      canvas.width=Math.round(img.width*scale);
      canvas.height=Math.round(img.height*scale);
      canvas.getContext('2d').drawImage(img,0,0,canvas.width,canvas.height);
      _photoDataUrl=canvas.toDataURL('image/jpeg',0.82);
      // show preview
      document.getElementById('photo-preview-img').src=_photoDataUrl;
      document.getElementById('photo-preview-wrap').classList.add('visible');
      document.getElementById('pm-save-btn').disabled=false;
      document.getElementById('photo-label-input').focus();
    };
    img.src=e.target.result;
  };
  reader.readAsDataURL(file);
}

function photoFileChosen(input){
  if(input.files&&input.files[0]) processImageFile(input.files[0]);
}

function photoDzOver(e){ e.preventDefault(); document.getElementById('photo-drop-zone').classList.add('dragover'); }
function photoDzLeave(e){ document.getElementById('photo-drop-zone').classList.remove('dragover'); }
function photoDzDrop(e){
  e.preventDefault();
  document.getElementById('photo-drop-zone').classList.remove('dragover');
  const file=e.dataTransfer.files[0];
  if(file) processImageFile(file);
}

function savePhoto(){
  const labelEl=document.getElementById('photo-label-input');
  const label=labelEl.value.trim();
  if(!_photoDataUrl){ alert('Please choose a photo first.'); return; }
  if(!label){
    labelEl.style.borderColor='var(--red)';
    labelEl.placeholder='⚠️ A name is required';
    labelEl.focus();
    setTimeout(()=>{ labelEl.style.borderColor=''; labelEl.placeholder='e.g. Mrs. Garcia, Dr. Patel, Pastor Mike'; },2000);
    return;
  }
  const id='custom:'+Date.now().toString(36)+Math.random().toString(36).slice(2,6);
  const photos=getCustomPhotos();
  photos.push({id, label, data:_photoDataUrl});
  saveCustomPhotos(photos);
  closePhotoModal();
  refreshAllBanksCustom();
  announce(label+' added to photo bank.');
}

