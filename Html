/* ═══════════════════════════════════════════
   ARASAAC CATEGORY LOADER
═══════════════════════════════════════════ */
let _loadProm = null;

async function loadAllCats(){
  if(_loadProm) return _loadProm;
  _loadProm = (async()=>{
    let ok = false;
    try {
      const t = await fetch('https://api.arasaac.org/v1/pictograms/en/search/happy',{signal:AbortSignal.timeout(5000)});
      ok = t.ok;
    } catch(e){ ok=false; }
    if(!ok){ Object.entries(FALLBACKS).forEach(([c,a])=>SYMS[c]=a); return; }
    for(const [cat,terms] of Object.entries(CAT_TERMS)){
      const batch = await Promise.all(terms.map(async([term,label])=>{
        try{
          const r=await fetch(`https://api.arasaac.org/v1/pictograms/en/search/${encodeURIComponent(term)}`,{signal:AbortSignal.timeout(4000)});
          if(!r.ok) return null;
          const d=await r.json();
          return d&&d.length ? [d[0]._id,label,cat] : null;
        } catch(e){ return null; }
      }));
      const res=batch.filter(Boolean);
      SYMS[cat] = res.length>=4 ? res : (FALLBACKS[cat]||res);
    }
  })();
  return _loadProm;
}

