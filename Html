/* ═══════════════════════════════════════════
   SPEECH ENGINE
═══════════════════════════════════════════ */
const SPEECH = {
  on: false,
  ok: 'speechSynthesis' in window,
  _v: null,
  _init(){
    if(this._v) return;
    const vs = speechSynthesis.getVoices();
    this._v = vs.find(v=>v.lang==='en-US'&&v.localService)
           || vs.find(v=>v.lang.startsWith('en')&&v.localService)
           || vs.find(v=>v.lang.startsWith('en'))
           || vs[0] || null;
  },
  say(word){
    if(!this.on||!this.ok) return;
    speechSynthesis.cancel();
    this._init();
    const u = new SpeechSynthesisUtterance(word);
    if(this._v) u.voice = this._v;
    u.lang='en-US'; u.rate=.88; u.pitch=1.05; u.volume=1;
    speechSynthesis.speak(u);
  }
};
if('speechSynthesis' in window)
  speechSynthesis.addEventListener('voiceschanged',()=>{ SPEECH._v=null; SPEECH._init(); });
(function(){ if(localStorage.getItem('aac_speech')==='1') _setSpeech(true); })();

function toggleSpeech(){
  _setSpeech(!SPEECH.on);
  if(SPEECH.on) SPEECH.say('Word reading is on');
}
function _setSpeech(on){
  SPEECH.on = on;
  const btn = document.getElementById('speech-toggle');
  const lbl = document.getElementById('tb-speech-lbl');
  if(btn) btn.setAttribute('aria-pressed',on?'true':'false');
  if(lbl) lbl.textContent = on ? t('speechOn') : t('speechOff');
  localStorage.setItem('aac_speech', on?'1':'0');
  if(on&&!SPEECH.ok){ alert('This browser does not support text-to-speech.\nTry Chrome, Edge, or Safari.'); _setSpeech(false); }
}

