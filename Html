<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
<title>Early Transition Skills – AAC / ARASAAC Edition</title>
<style>
/* ── FONTS ──
   Android Chrome does not ship Comic Sans MS.
   'Arial Rounded MT Bold' → Arial Bold renders clean and student-friendly
   on every platform including Galaxy Note.
   Vietnamese stays on plain Arial to preserve diacritics.
*/
body.lang-vi,
body.lang-vi button,
body.lang-vi input,
body.lang-vi select,
body.lang-vi span,
body.lang-vi div,
body.lang-vi h1,
body.lang-vi h2,
body.lang-vi p {
  font-family: Arial, 'Helvetica Neue', sans-serif !important;
}

/* ══════════════ DESIGN TOKENS ══════════════ */
:root {
  --uco-blue:   #002D62;
  --uco-bronze: #C8970A;
  --red:        #b91c3f;  --red-bg:    #fde8ef;
  --yellow:     #a36200;  --yel-bg:    #fffbea;
  --blue:       #1a4fa0;  --blue-bg:   #e8f0fd;
  --teal:       #0b6b60;  --teal-bg:   #e0f7f4;
  --purple:     #5a1d8a;  --purp-bg:   #f0e8ff;
  --green:      #155a22;  --grn-bg:    #e6f4e9;
  --orange:     #a83d00;  --org-bg:    #fff0e6;
  --dark:       #0f172a;
  --radius:     14px;
  --sym-sz:     108px;
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
body{
  font-family: 'Arial Rounded MT Bold', 'Varela Round', Arial, sans-serif;
  font-weight: 800;
  background: #94a3b8;
  color: var(--dark);
  -webkit-user-select: none;
  user-select: none;
}
.sr-only { position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);border:0; }

/* ══════════════ TOOLBAR ══════════════ */
.toolbar {
  background: var(--uco-blue);
  color: #fff;
  padding: 6px 16px;
  display: flex;
  flex-direction: column;
  gap: 5px;
  position: sticky;
  top: 0;
  z-index: 500;
  box-shadow: 0 2px 12px rgba(0,0,0,.4);
}
.toolbar-row {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-wrap: wrap;
}
.toolbar-title {
  font-size: .88rem;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
}
.toolbar-badge {
  background: var(--uco-bronze);
  color: #fff;
  border-radius: 8px;
  padding: 2px 10px;
  font-size: .72rem;
  font-weight: 900;
  white-space: nowrap;
  flex-shrink: 0;
}

/* student switcher */
.stu-switcher {
  display: flex;
  align-items: center;
  gap: 6px;
  background: rgba(255,255,255,.1);
  border-radius: 10px;
  padding: 4px 10px;
  flex: 1;
  min-width: 0;
  flex-wrap: wrap;
}
.stu-label { font-size:.8rem;font-weight:900;color:#FFD700;white-space:nowrap; }
#stu-select {
  font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:.9rem;font-weight:800;
  background:#fff;color:var(--dark);border:2px solid #aaa;border-radius:8px;
  padding:3px 8px;min-height:32px;flex:1;min-width:80px;max-width:200px;cursor:pointer;
}
#stu-select:focus { outline: 2px solid #FFD700; }
.stu-btn {
  font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:.78rem;font-weight:900;
  border-radius:8px;padding:3px 10px;cursor:pointer;min-height:32px;
  white-space:nowrap;border:2px solid rgba(255,255,255,.35);
}
.stu-add  { background:#155a22;color:#fff; }
.stu-add:hover  { background:#0e3d16; }
.stu-ren  { background:rgba(255,255,255,.15);color:#fff; }
.stu-ren:hover  { background:rgba(255,255,255,.28); }
.stu-del  { background:#b91c3f;color:#fff; }
.stu-del:hover  { background:#7b1025; }

/* toolbar action buttons */
.tb-btn {
  font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:.8rem;font-weight:900;
  border-radius:8px;padding:4px 11px;cursor:pointer;min-height:32px;
  white-space:nowrap;border:2px solid rgba(255,255,255,.35);
  flex-shrink: 0;
}
.tb-speech { background:rgba(255,255,255,.12);color:#fff; }
.tb-speech[aria-pressed="true"] { background:#155a22;border-color:#4caf50; }
.tb-photos { background:rgba(255,255,255,.12);color:#fff; }
.tb-photos:hover { background:rgba(255,255,255,.24); }
.tb-print  { background:#0b6b60;color:#fff; }
.tb-print:hover { background:#085248; }

/* language toggle */
.lang-toggle {
  display:flex;align-items:center;gap:0;
  background:rgba(255,255,255,.12);border-radius:8px;overflow:hidden;
  border:2px solid rgba(255,255,255,.35);flex-shrink:0;
}
.lang-btn {
  font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:.78rem;font-weight:900;
  padding:3px 10px;cursor:pointer;min-height:32px;border:none;
  background:transparent;color:rgba(255,255,255,.65);transition:background .12s,color .12s;
}
.lang-btn.active { background:#fff;color:var(--uco-blue); }
.lang-btn:hover:not(.active) { background:rgba(255,255,255,.2);color:#fff; }

@media print { .toolbar { display:none!important; } }

/* ══════════════ PAGE CHROME ══════════════ */
.page {
  width:100%;max-width:8.5in;min-height:11in;
  margin:20px auto;background:#fff;
  box-shadow:0 6px 28px rgba(0,0,0,.22);
  display:flex;flex-direction:column;
  page-break-after:always;page-break-inside:avoid;
  overflow:visible;
  position:relative;
}
@media print {
  .page { width:8.5in;min-height:11in;margin:0;box-shadow:none;overflow:hidden; }
}

/* cover banner on screen */
.stu-banner {
  background: var(--uco-blue);
  color: #fff;
  text-align: center;
  padding: 7px 16px;
  font-family: 'Arial Rounded MT Bold', 'Varela Round', Arial, sans-serif;
  font-size: 1.25rem;
  border-bottom: 3px solid var(--dark);
  flex-shrink: 0;
}
/* printed student name strip */
.print-stu-name {
  display:none;
  font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:.9rem;
  color:var(--uco-blue);text-align:right;padding:4px 12px;
  border-bottom:2px solid #eee;flex-shrink:0;
}
@media print {
  .print-stu-name { display:block!important; }
  .stu-banner     { display:none!important; }
}

/* ══════════════ ROUTING ══════════════ */
#aac-cover { display:flex;flex-direction:column; }
#aac-cover.hidden { display:none; }
.section-page { display:none; }
.section-page.active { display:block;width:100%; }
@media print {
  #aac-cover { display:none!important; }
  .section-page { display:block!important; }
  .section-page .page { display:flex!important; }
}
#aac-cover, .section-page { animation:fadein .14s ease; }
@keyframes fadein { from{opacity:0} to{opacity:1} }

/* ══════════════ COVER ══════════════ */
.pg-cover { background:var(--teal); }
.cover-head {
  background: #FFD700;
  text-align:center;padding:18px 30px 14px;
  border-bottom:6px solid var(--dark);
}
.cover-head h1 {
  font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:2.8rem;
  color:var(--dark);line-height:1.05;
}
.edition-badge {
  display:inline-block;background:var(--teal);color:#fff;
  border-radius:20px;padding:3px 18px;font-size:1rem;font-weight:900;margin-top:5px;
}
.cover-sub {
  background:var(--uco-blue);text-align:center;padding:10px;
  border-bottom:6px solid var(--dark);
}
.cover-sub h2 { font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:2rem;color:#fff; }
.cover-grid {
  display:grid;grid-template-columns:repeat(3,1fr);
  gap:8px;padding:10px;background:var(--dark);flex:1;
}
.cover-cell {
  background:#0a5e54;border-radius:12px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:6px;padding:10px 6px;cursor:pointer;
  border:4px solid transparent;
  transition:border-color .15s,background .12s,transform .12s;
  position:relative;
}
.cover-cell:hover,.cover-cell:focus-visible {
  background:#074d43;border-color:#FFD700;transform:scale(1.04);outline:none;
}
.cc-emoji { font-size:2.5rem; }
.cc-lbl { font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:1.15rem;color:#fff;text-align:center; }
.cc-tap { font-size:.78rem;color:rgba(255,255,255,.6);font-weight:800; }
.prog-badge {
  position:absolute;top:6px;right:6px;
  background:#155a22;color:#fff;border-radius:20px;
  padding:2px 8px;font-size:.7rem;font-weight:900;pointer-events:none;
}
.cover-foot {
  background:var(--dark);text-align:center;
  padding:8px 16px 10px;color:#e5e7eb;
  font-size:.7rem;font-weight:700;flex-shrink:0;line-height:1.65;
}
.cc-gold { color:#FFD700;font-weight:900; }
.cc-lic {
  display:inline-flex;align-items:center;gap:5px;margin-top:3px;
  background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);
  border-radius:6px;padding:2px 10px;color:#d1d5db;font-size:.66rem;
}

/* ══════════════ SECTION PAGES ══════════════ */
.back-bar {
  background:var(--dark);display:flex;align-items:center;
  gap:14px;padding:9px 18px;flex-shrink:0;
}
.back-btn {
  background:#FFD700;color:var(--dark);border:3px solid var(--dark);
  border-radius:10px;padding:7px 18px;
  font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:1rem;font-weight:900;
  cursor:pointer;min-height:44px;
}
.back-btn:hover { outline:3px solid #fff; }
.sec-indicator { color:#fff;font-size:1rem;font-weight:900; }

.inner {
  flex:1;padding:.35in .4in .3in;
  display:flex;flex-direction:column;gap:10px;
  overflow:hidden;min-height:0;
}
.page-title { font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:2rem;line-height:1.1;flex-shrink:0; }
.page-prompt { font-size:1.12rem;font-weight:900;line-height:1.4;flex-shrink:0; }

/* search row */
.search-row { display:flex;gap:8px;align-items:center;flex-shrink:0; }
.sym-search {
  font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:1rem;font-weight:800;
  padding:8px 14px;border:2.5px solid #767676;border-radius:10px;
  flex:1;min-height:42px;
}
.sym-search:focus { border-color:var(--blue);outline:none;box-shadow:0 0 0 3px rgba(26,79,160,.25); }
.search-btn {
  background:var(--blue);color:#fff;border:none;border-radius:10px;
  padding:8px 16px;font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:1rem;font-weight:900;
  cursor:pointer;min-height:42px;
}
.search-btn:hover { background:#1244a0; }
.clear-btn {
  background:#fff;border:3px solid #767676;border-radius:10px;
  padding:6px 14px;font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:.92rem;font-weight:900;
  color:var(--dark);cursor:pointer;min-height:42px;flex-shrink:0;
}
.clear-btn:hover { background:#f0f0f0; }
.search-status { font-size:.82rem;color:#666;font-weight:700;flex-shrink:0;text-align:center; }

/* symbol bank */
.sym-bank {
  background:#f5f5f5;border:3px solid #767676;border-radius:var(--radius);
  padding:10px 12px;flex-shrink:0;
}
.bank-label { font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:1.05rem;color:#444;margin-bottom:8px; }
.bank-scroll { max-height:210px;overflow-y:auto;overflow-x:hidden; }
.bank-row { display:flex;flex-wrap:wrap;gap:8px;min-height:50px; }

/* symbol card */
.sym {
  width:var(--sym-sz);min-height:var(--sym-sz);
  background:#fff;border:3px solid #555;border-radius:var(--radius);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:3px;cursor:grab;padding:6px 4px;
  transition:transform .12s,box-shadow .12s,opacity .12s;
  touch-action:none;position:relative;
}
.sym:hover { transform:scale(1.07);box-shadow:0 4px 16px rgba(0,0,0,.2); }
.sym.dragging { opacity:.35; }
.sym.used { opacity:.3;pointer-events:none;border-style:dashed; }
.sym img { width:70px;height:70px;object-fit:contain;display:block; }
.sym .img-ph { width:70px;height:70px;display:flex;align-items:center;justify-content:center;font-size:2.5rem; }
.sym .s-word { font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:.76rem;color:var(--dark);text-align:center;line-height:1.2;padding:0 2px; }

.sym.cat-feel   { border-color:var(--red);   background:var(--red-bg); }
.sym.cat-people { border-color:var(--blue);  background:var(--blue-bg); }
.sym.cat-place  { border-color:var(--green); background:var(--grn-bg); }
.sym.cat-food   { border-color:var(--orange);background:var(--org-bg); }
.sym.cat-action { border-color:var(--teal);  background:var(--teal-bg); }
.sym.cat-thing  { border-color:var(--purple);background:var(--purp-bg); }
.sym.cat-time   { border-color:var(--yellow);background:var(--yel-bg); }
.sym.cat-jobs   { border-color:var(--uco-blue);background:#e8f0fd; }

/* answer area */
.answer-area { flex:1;display:flex;flex-direction:column;gap:8px;min-height:0;overflow:hidden; }
.answer-grid { display:grid;gap:8px;flex:1;min-height:0;align-content:start; }
.answer-grid.cols-2 { grid-template-columns:1fr 1fr; }
.answer-grid.cols-3 { grid-template-columns:1fr 1fr 1fr; }

/* drop zone */
.drop-zone {
  background:rgba(255,255,255,.6);border:3px dashed #aaa;border-radius:var(--radius);
  padding:8px 10px;display:flex;flex-direction:column;align-items:center;
  gap:6px;min-height:150px;transition:background .15s,border-color .15s;
}
.drop-zone.drag-over { background:#e8f5e9;border-color:var(--green);border-style:solid;box-shadow:0 0 0 4px rgba(21,90,34,.2); }
.dz-lbl { font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:1rem;color:#555;text-align:center;flex-shrink:0;width:100%; }
.dz-ph  { font-size:.8rem;font-weight:700;color:#bbb;text-align:center; }
.dz-cards { display:flex;flex-wrap:wrap;gap:5px;justify-content:center;width:100%; }

.dz-red    { border-color:var(--red); }
.dz-blue   { border-color:var(--blue); }
.dz-green  { border-color:var(--green); }
.dz-teal   { border-color:var(--teal); }
.dz-orange { border-color:var(--orange); }
.dz-purple { border-color:var(--purple); }
.dz-yellow { border-color:var(--yellow); }

/* dropped card */
.dropped {
  background:#fff;border:2.5px solid #555;border-radius:10px;
  padding:5px 6px;display:flex;flex-direction:column;align-items:center;
  gap:2px;min-width:70px;position:relative;
}
.dropped img { width:50px;height:50px;object-fit:contain; }
.dropped .d-word { font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:.68rem;color:var(--dark);text-align:center; }
.dropped .d-em   { font-size:1.9rem;line-height:1; }
.d-remove {
  position:absolute;top:-8px;right:-8px;
  background:var(--red);color:#fff;border-radius:50%;
  width:20px;height:20px;font-size:.72rem;font-weight:900;
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;border:2px solid #fff;line-height:1;
}
.d-remove:hover { background:#7b1025; }

/* ARASAAC credit bar */
.arasaac-bar {
  background:#f0f0f0;border-top:2px solid #ccc;
  padding:4px 12px;font-size:.63rem;font-weight:700;color:#555;
  text-align:center;flex-shrink:0;
}

/* page colour themes */
.pg-str  { background:var(--red-bg); }  .pg-str  .page-title { color:var(--red); }
.pg-sup  { background:var(--blue-bg); } .pg-sup  .page-title { color:var(--blue); }
.pg-pref { background:#fff; }           .pg-pref .page-title { color:var(--purple); }
.pg-me   { background:var(--teal-bg); } .pg-me   .page-title { color:var(--teal); }
.pg-iep  { background:var(--blue-bg); } .pg-iep  .page-title { color:var(--blue); }
.pg-goal { background:var(--yel-bg); }  .pg-goal .page-title { color:var(--yellow); }
.pg-comm { background:#fff; }           .pg-comm .page-title { color:var(--teal); }
.pg-food { background:var(--org-bg); }  .pg-food .page-title { color:var(--orange); }
.pg-dream{ background:var(--yel-bg); }  .pg-dream.page-title { color:var(--orange); }

/* ══════════════ FERPA MODAL ══════════════ */
.modal-overlay {
  position:fixed;inset:0;background:rgba(0,0,0,.55);
  z-index:2000;display:flex;align-items:center;justify-content:center;
  padding:12px;animation:fadein .15s ease;
}
.modal-overlay.hidden { display:none; }
.modal-box {
  background:#fff;border-radius:14px;padding:18px 22px 16px;
  max-width:480px;width:100%;max-height:calc(100vh - 24px);overflow-y:auto;
  box-shadow:0 8px 36px rgba(0,0,0,.32);font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;
}
.modal-title { font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:1.25rem;color:var(--blue);margin-bottom:8px; }
.modal-ferpa {
  background:#fff8e1;border:2px solid var(--uco-bronze);border-radius:8px;
  padding:6px 10px;font-size:.76rem;font-weight:800;color:#5a3d00;
  margin-bottom:10px;line-height:1.4;
}
.modal-ferpa strong { color:var(--uco-bronze); }
.modal-opts { display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-bottom:10px; }
.modal-opt {
  display:flex;flex-direction:column;align-items:center;gap:4px;
  background:#f5f5f5;border:2.5px solid #ccc;border-radius:10px;
  padding:8px 6px 7px;cursor:pointer;text-align:center;width:100%;
  transition:border-color .12s,background .12s;font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;
}
.modal-opt:hover { background:var(--blue-bg);border-color:var(--blue); }
.modal-opt.sel   { background:var(--blue-bg);border-color:var(--blue); }
.modal-opt:focus-visible { outline:3px solid var(--blue);outline-offset:2px; }
.opt-icon { font-size:1.3rem;line-height:1; }
.opt-lbl  { font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:.8rem;color:var(--dark);line-height:1.2; }
.opt-ex   { display:inline-block;margin-top:2px;background:var(--blue);color:#fff;border-radius:5px;padding:1px 6px;font-size:.66rem;font-weight:900; }
.modal-field { display:flex;flex-direction:column;gap:4px;margin-bottom:10px; }
.modal-field label { font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:.95rem;color:var(--dark); }
.modal-input {
  font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:1rem;font-weight:800;
  border:2.5px solid #767676;border-radius:8px;padding:7px 12px;
  width:100%;min-height:40px;
}
.modal-input:focus { border-color:var(--blue);box-shadow:0 0 0 3px rgba(26,79,160,.2);outline:none; }
.modal-btns { display:flex;gap:8px;justify-content:flex-end; }
.m-cancel {
  background:#fff;border:2.5px solid #767676;border-radius:8px;
  padding:7px 18px;font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:.9rem;font-weight:900;cursor:pointer;min-height:38px;
}
.m-cancel:hover { background:#f0f0f0; }
.m-confirm {
  background:var(--blue);color:#fff;border:none;border-radius:8px;
  padding:7px 20px;font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;font-size:.9rem;font-weight:900;cursor:pointer;min-height:38px;
}
.m-confirm:hover { background:#1244a0; }
@media(max-width:500px) {
  .modal-opts { grid-template-columns:1fr; }
}

/* ══════════════ CUSTOM PHOTO SYSTEM ══════════════ */

/* toolbar manage button */
.tb-photos { background:rgba(255,255,255,.12);color:#fff; }
.tb-photos:hover { background:rgba(255,255,255,.24); }

/* add-photo button inside symbol bank */
.add-photo-btn {
  width:var(--sym-sz);min-height:var(--sym-sz);
  background:#fff;border:3px dashed var(--uco-bronze);border-radius:var(--radius);
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  gap:4px;cursor:pointer;padding:6px 4px;
  transition:background .12s,border-color .12s;
  font-family:'Arial Rounded MT Bold','Varela Round',Arial,sans-serif;flex-shrink:0;
}
.add-photo-btn:hover { background:#fffbea;border-color:#8a5e00; }
.add-photo-btn:focus-visible { outline:3px solid var(--uco-bronze);outline-offset:2px; }
.add-photo-btn .ap-icon { font-size:2rem;line-height:1; }
.add-photo-btn .ap-lbl  { font-size:.72rem;font-weight:900;color:var(--uco-bronze);text-align:center;line-height:1.2; }

