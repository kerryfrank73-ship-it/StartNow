function t(key){ return LANG[_lang][key] || LANG.en[key] || key; }
function tSec(secKey, prop){ return (LANG[_lang].sections[secKey]||LANG.en.sections[secKey])[prop]; }

function setLang(lang){
  _lang = lang;
  localStorage.setItem('aac_lang', lang);
  // Toggle active state
  document.getElementById('lang-en').classList.toggle('active', lang==='en');
  document.getElementById('lang-es').classList.toggle('active', lang==='es');
  document.getElementById('lang-vi').classList.toggle('active', lang==='vi');
  // Vietnamese font override via body class
  document.body.classList.toggle('lang-vi', lang==='vi');
  // Update speech engine language
  SPEECH._v = null;
  SPEECH._lang = lang==='es' ? 'es-US' : lang==='vi' ? 'vi-VN' : 'en-US';
  applyLang();
}

function applyLang(){
  const L = LANG[_lang];
  // Toolbar
  const sl=document.getElementById('tb-stu-label'); if(sl) sl.textContent=L.stuLabel;
  const bn=document.getElementById('tb-btn-new');   if(bn) bn.textContent=L.btnNew;
  const br=document.getElementById('tb-btn-ren');   if(br) br.textContent=L.btnRen;
  const bd=document.getElementById('tb-btn-del');   if(bd) bd.textContent=L.btnDel;
  const sp=document.getElementById('tb-speech-lbl');if(sp) sp.textContent=SPEECH.on?L.speechOn:L.speechOff;
  const ph=document.getElementById('tb-photos-lbl');if(ph) ph.textContent=L.myPhotos;
  const pr=document.getElementById('tb-print-lbl'); if(pr) pr.textContent=L.printAll;
  // Cover subtitle
  const cs=document.querySelector('.cover-sub h2'); if(cs) cs.textContent=L.coverSub;
  // Cover grid cells
  document.querySelectorAll('.cover-cell[data-seckey]').forEach(cell=>{
    const key=cell.dataset.seckey;
    const [emoji,lbl]=L.coverSections[key]||['',''];
    const eEl=cell.querySelector('.cc-emoji'); if(eEl) eEl.textContent=emoji;
    const lEl=cell.querySelector('.cc-lbl');   if(lEl) lEl.textContent=lbl;
    const tEl=cell.querySelector('.cc-tap');   if(tEl) tEl.textContent=L.ccTap;
  });
  // Section pages — titles, prompts, zone labels, bank label, search, placeholders
  Object.keys(PAGES).forEach(key=>{
    const sec=document.getElementById('aac-sec-'+key); if(!sec) return;
    const sd=L.sections[key]; if(!sd) return;
    const titleEl=sec.querySelector('.page-title');  if(titleEl) titleEl.textContent=sd.title;
    const promptEl=sec.querySelector('.page-prompt'); if(promptEl) promptEl.textContent=sd.prompt;
    const backEl=sec.querySelector('.back-btn');      if(backEl) backEl.textContent=L.backBtn;
    const secInd=sec.querySelector('.sec-indicator'); if(secInd) secInd.textContent=sd.title;
    const blEl=sec.querySelector('.bank-label');      if(blEl) blEl.textContent=L.bankLbl;
    const srch=sec.querySelector('.sym-search');      if(srch) srch.placeholder=L.searchPh;
    const sBtn=sec.querySelector('.search-btn');      if(sBtn) sBtn.textContent=L.searchBtn;
    const cBtn=sec.querySelector('.clear-btn');       if(cBtn) cBtn.textContent=L.clearBtn;
    // Add photo button
    sec.querySelectorAll('.add-photo-btn .ap-lbl').forEach(el=>el.textContent=L.addPhotoLbl.replace('\n',' '));
    // Drop zone labels + placeholders
    const zones=sec.querySelectorAll('.drop-zone');
    zones.forEach((z,i)=>{
      const lblEl=z.querySelector('.dz-lbl'); if(lblEl&&sd.zones[i]) lblEl.textContent=sd.zones[i];
      const phEl=z.querySelector('.dz-ph');   if(phEl) phEl.textContent=L.dzPh;
    });
    // ARASAAC bar
    const ab=sec.querySelector('.arasaac-bar'); if(ab) ab.textContent=L.arasaacBar;
  });
  // Photo upload modal
  const pmTitle=document.getElementById('photo-modal-title'); if(pmTitle) pmTitle.textContent=L.photoTitle;
  const pdText=document.querySelector('.pdz-text');  if(pdText) pdText.textContent=L.photoDzText;
  const pdSub=document.querySelector('.pdz-sub');    if(pdSub)  pdSub.textContent=L.photoDzSub;
  const plLbl=document.querySelector('.photo-label-field label'); if(plLbl) plLbl.textContent=L.photoLbl;
  const plInp=document.getElementById('photo-label-input'); if(plInp) plInp.placeholder=L.photoPh;
  const pmCan=document.querySelector('.pm-cancel'
