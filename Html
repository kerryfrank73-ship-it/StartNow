let lastTap = null;

function tapSym(el, pageKey){
  if(el.classList.contains('used')) return;
  if(lastTap&&lastTap.el===el){ el.style.outline=''; lastTap=null; return; }
  if(lastTap) lastTap.el.style.outline='';
  lastTap={el,pageKey};
  el.style.outline='4px solid #FFD700';
  el.style.outlineOffset='2px';
  SPEECH.say(el.dataset.label);
  announce(el.dataset.label+' selected. Now tap a box to place it.');
}

document.addEventListener('click',e=>{
  const zone=e.target.closest('.drop-zone');
  if(zone&&lastTap){
    const placed=lastTap;
    placed.el.style.outline=''; lastTap=null;
    placeCard(zone,placed.el,placed.pageKey);
    SPEECH.say(placed.el.dataset.label);
    announce('Picture placed!');
  }
});

/* ═══════════════════════════════════════════
   DRAG-TO-DELETE TRASH HELPERS
═══════════════════════════════════════════ */
function _isCustomSym(el){ return el && el.dataset && String(el.dataset.id).startsWith('custom:'); }

function _showTrash(){
  document.getElementById('drag-trash').classList.add('visible');
}
function _hideTrash(){
  const t=document.getElementById('drag-trash');
  t.classList.remove('visible','over');
}
function _trashOver(){ document.getElementById('drag-trash').classList.add('over'); }
function _trashOut(){  document.getElementById('drag-trash').classList.remove('over'); }

function _deleteCustomSym(symEl){
  const id=symEl.dataset.id, label=symEl.dataset.label;
  const photos=getCustomPhotos();
  saveCustomPhotos(photos.filter(p=>p.id!==id));
  // Remove from every bank
  document.querySelectorAll(`[data-id="${id}"]`).forEach(e=>e.remove());
  announce(label+' deleted.');
}

