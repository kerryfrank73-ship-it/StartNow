function makeSymEl(id, label, cat, pageKey){
  const div = document.createElement('div');
  div.className = `sym cat-${cat}`;
  div.draggable = true;
  div.tabIndex = 0;
  div.setAttribute('role','button');
  div.setAttribute('aria-label', label);
  div.dataset.id    = String(id);
  div.dataset.label = label;
  div.dataset.cat   = cat;
  div.dataset.page  = pageKey;
  const fb = EMOJI_FB[id] || CAT_EMOJI[cat] || '⭐';
  div.innerHTML = `
    <img src="${imgUrl(id)}" alt="${label}" loading="lazy"
         onerror="this.style.display='none';this.nextElementSibling.style.display='flex'">
    <div class="img-ph" style="display:none">${fb}</div>
    <span class="s-word">${label}</span>`;
  div.addEventListener('click',()=>tapSym(div,pageKey));
  div.addEventListener('keydown',e=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); tapSym(div,pageKey); } });
  return div;
}

function populateBank(key){
  const cfg=PAGES[key], bank=document.getElementById('bank-'+key);
  if(!bank) return;
  const needsLoad = cfg.cats.some(c=>c!=='food'&&(!SYMS[c]||!SYMS[c].length));
  if(needsLoad){
    bank.innerHTML='<div style="padding:10px;font-weight:800;color:#666">⏳ Loading pictures…</div>';
    loadAllCats().then(()=>{ delete bank.dataset.loaded; _fillBank(key); });
    return;
  }
  _fillBank(key);
}

function _fillBank(key){
  const cfg=PAGES[key], bank=document.getElementById('bank-'+key);
  if(!bank||bank.dataset.loaded) return;
  bank.dataset.loaded='1';

  // Remove everything EXCEPT the persistent Add Photo button
  Array.from(bank.children).forEach(c=>{ if(!c.classList.contains('add-photo-btn')) c.remove(); });

  let syms=[];
  for(const c of cfg.cats){ if(SYMS[c]&&SYMS[c].length) syms=syms.concat(SYMS[c]); }
  const seen=new Set();
  syms=syms.filter(s=>{ if(seen.has(s[0])) return false; seen.add(s[0]); return true; });
  if(!syms.length){
    const msg=document.createElement('div');
    msg.style.cssText='padding:8px;color:var(--red);font-weight:900';
    msg.textContent='⚠️ No pictures loaded — use the Search box above.';
    bank.appendChild(msg);
  } else {
    syms.forEach(([id,lbl,cat])=>bank.appendChild(makeSymEl(id,lbl,cat,key)));
  }

  // Inject custom photos at the end of the bank
  injectCustomPhotos(key);
}

/* live search */
async function searchSyms(key){
  const q=document.getElementById(`search-${key}`).value.trim();
  if(!q) return;
  const status=document.getElementById(`status-${key}`);
  const bank=document.getElementById(`bank-${key}`);
  status.textContent=`Searching for "${q}"…`;
  try{
    const res=await fetch(`https://api.arasaac.org/v1/pictograms/en/search/${encodeURIComponent(q)}`);
    if(!res.ok) throw new Error();
    const data=await res.json();
    const results=data.slice(0,24);
    if(!results.length){ status.textContent=`No results for "${q}" — try another word.`; return; }
    bank.querySelectorAll('.search-result').forEach(e=>e.remove());
    results.forEach(item=>{
      const el=makeSymEl(item._id, item.keywords[0]?.keyword||q,'thing',key);
      el.classList.add('search-result');
      bank.appendChild(el);
    });
    status.textContent=`Found ${results.length} pictures for "${q}".`;
    bank.parentElement.scrollTop=bank.parentElement.scrollHeight;
    announce(`Found ${results.length} pictures for ${q}`);
  } catch(e){ status.textContent='Search unavailable — using the pictures below.'; }
}

