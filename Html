const MAX_STU=50, KEY_LIST='aac_students', KEY_CUR='aac_current';
const dataKey=n=>'aac_data_'+n;

function getStudents(){ try{return JSON.parse(localStorage.getItem(KEY_LIST))||[];}catch(e){return [];} }
function saveStudents(a){ try{localStorage.setItem(KEY_LIST,JSON.stringify(a));}catch(e){} }
function getCurrent(){ return localStorage.getItem(KEY_CUR)||''; }
function setCurrent(name){ localStorage.setItem(KEY_CUR,name); refreshStuUI(); }

function refreshStuUI(){
  const stus=getStudents(), cur=getCurrent();
  const sel=document.getElementById('stu-select');
  if(!sel) return;
  sel.innerHTML='';
  stus.forEach(n=>{ const o=document.createElement('option'); o.value=n; o.textContent=n; if(n===cur) o.selected=true; sel.appendChild(o); });
  const banner=document.getElementById('cover-stu-name');
  if(banner) banner.textContent=cur?'👤 '+cur:'👤 No student selected';
  document.querySelectorAll('.print-stu-name').forEach(el=>el.textContent=cur?'Student: '+cur:'');
  updateProgress();
}

function addStudent(){
  if(getStudents().length>=MAX_STU){ alert('Maximum of '+MAX_STU+' students reached.'); return; }
  openModal('add');
}
function switchStudent(name){ if(!name) return; clearAllDOM(); setCurrent(name); updateProgress(); announce('Switched to '+name); }
function renameStudent(){
  const cur=getCurrent(); if(!cur){ alert('No student selected.'); return; }
  const nw=prompt('Rename "'+cur+'" to:',cur);
  if(!nw||!nw.trim()||nw.trim()===cur) return;
  const t=nw.trim(), stus=getStudents();
  if(stus.includes(t)){ alert(t+' already exists.'); return; }
  saveStudentState(t,loadStudentState(cur));
  try{localStorage.removeItem(dataKey(cur));}catch(e){}
  const idx=stus.indexOf(cur); if(idx>-1) stus[idx]=t;
  saveStudents(stus); setCurrent(t); announce('Renamed to '+t);
}
function deleteStudent(){
  const cur=getCurrent(); if(!cur){ alert('No student selected.'); return; }
  if(!confirm('Delete all data for "'+cur+'"? This cannot be undone.')) return;
  try{localStorage.removeItem(dataKey(cur));}catch(e){}
  const stus=getStudents().filter(n=>n!==cur); saveStudents(stus); clearAllDOM();
  if(stus.length){ setCurrent(stus[0]); } else { localStorage.removeItem(KEY_CUR); refreshStuUI(); }
  announce(cur+' deleted.');
}

/* state */
function loadStudentState(n){ if(!n) return {}; try{return JSON.parse(localStorage.getItem(dataKey(n)))||{};}catch(e){return {};} }
function saveStudentState(n,s){ if(!n) return; try{localStorage.setItem(dataKey(n),JSON.stringify(s));}catch(e){} }
function loadState(){ return loadStudentState(getCurrent()); }
function saveState(s){ saveStudentState(getCurrent(),s); }
function getPageState(key){ return loadState()[key]||{}; }
function setZoneState(pageKey,zoneId,cards){
  const s=loadState(); if(!s[pageKey]) s[pageKey]={}; s[pageKey][zoneId]=cards; saveState(s); updateProgress();
}
function clearPageState(key){ const s=loadState(); delete s[key]; saveState(s); updateProgress(); }

function clearAllDOM(){
  Object.keys(PAGES).forEach(key=>{
    const sec=document.getElementById('aac-sec-'+key); if(!sec) return;
    sec.querySelectorAll('.drop-zone').forEach(z=>{
      z.querySelector('.dz-cards').innerHTML='';
      const ph=z.querySelector('.dz-ph'); if(ph) ph.style.display='';
    });
    sec.querySelectorAll('.sym').forEach(s=>{ s.classList.remove('used'); s.style.outline=''; });
    // invalidate bank but keep the Add Photo button
    const bank=document.getElementById('bank-'+key);
    if(bank){
      Array.from(bank.children).forEach(c=>{ if(!c.classList.contains('add-photo-btn')) c.remove(); });
      delete bank.dataset.loaded;
    }
  });
}

function restorePage(key){
  const ps=getPageState(key);
  if(!Object.keys(ps).length) return;
  for(const [zoneId,cards] of Object.entries(ps)){
    const zone=document.getElementById(zoneId);
    if(!zone||!cards.length) continue;
    if(zone.querySelectorAll('.dropped').length===cards.length) continue;
    zone.querySelector('.dz-cards').innerHTML='';
    const ph=zone.querySelector('.dz-ph'); if(ph) ph.style.display='none';
    cards.forEach(({id,label})=>{
      _renderCard(zone,id,label,key);
      document.querySelectorAll(`#bank-${key} [data-id="${id}"]`).forEach(e=>e.classList.add('used'));
    });
  }
}

function resetPage(key){
  const sec=document.getElementById(`aac-sec-${key}`); if(!sec) return;
  sec.querySelectorAll('.drop-zone').forEach(z=>{ z.querySelector('.dz-cards').innerHTML=''; const ph=z.querySelector('.dz-ph');if(ph) ph.style.display=''; });
  sec.querySelectorAll('.sym').forEach(s=>{ s.classList.remove('used'); s.style.outline=''; });
  if(lastTap&&lastTap.pageKey===key){ lastTap=null; }
  const st=document.getElementById(`status-${key}`); if(st) st.textContent='';
  clearPageState(key);
}

function updateProgress(){
  const state=loadState();
  document.querySelectorAll('.cover-cell').forEach(cell=>{
    const key=cell.dataset.seckey; if(!key) return;
    const count=Object.values(state[key]||{}).reduce((n,a)=>n+(a?a.length:0),0);
    let badge=cell.querySelector('.prog-badge');
    if(count>0){
      if(!badge){ badge=document.createElement('span'); badge.className='prog-badge'; badge.setAttribute('aria-label',count+' pictures placed'); cell.appendChild(badge); }
      badge.textContent='✅ '+count;
    } else { if(badge) badge.remove(); }
  });
}

